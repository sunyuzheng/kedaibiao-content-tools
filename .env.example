# Transistor.fm（从 https://dashboard.transistor.fm/account 获取）
TRANSISTOR_API_KEY=your_transistor_api_key_here
TRANSISTOR_SHOW_ID=your_show_id_here

# 每周播客对账邮件（可选；三项必须一起配置）
RESEND_API_KEY=your_resend_sending_key_here
RESEND_FROM_EMAIL="课代表播客自动化 <podcast@your-verified-domain.example>"
PODCAST_SYNC_EMAIL_TO=your_email@example.com

# Claude 字幕校对（batch_correct_srt.py 等批量工具用）
ANTHROPIC_API_KEY=your_anthropic_api_key_here
